{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Livepage Studio",
  "version": "0.1.1",
  "identifier": "com.livepage.studio",
  "build": {
    "devUrl": "http://127.0.0.1:8912",
    "frontendDist": "../../app"
  },
  "app": {
    "windows": [
      {
        "title": "Livepage Studio",
        "width": 1500,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}